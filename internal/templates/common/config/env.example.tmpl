# Gateway
ANTHROPIC_API_KEY=
CLOUDFLARE_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=
OLLAMA_CLOUD_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# A2A Agent Server / LLM client
A2A_DEBUG=false
{{- if .ADL.Spec.Agent }}
A2A_AGENT_CLIENT_PROVIDER={{ .ADL.Spec.Agent.Provider }}
A2A_AGENT_CLIENT_MODEL={{ .ADL.Spec.Agent.Model }}
A2A_AGENT_CLIENT_BASE_URL=http://gateway:8080/v1
{{- end }}

# CLI
{{- if .ADL.Spec.Agent }}
CLI_PROVIDER={{ .ADL.Spec.Agent.Provider }}
CLI_MODEL={{ .ADL.Spec.Agent.Model }}
{{- end }}
{{- if and .ADL.Spec.Language.Rust (has "redis" .ADL.Spec.Language.Rust.Features) }}

# Task queue (Redis)
A2A_QUEUE_PROVIDER=redis
A2A_QUEUE_URL=redis://localhost:6379
A2A_QUEUE_NAMESPACE=a2a
{{- end }}
{{- if and .ADL.Spec.Telemetry .ADL.Spec.Telemetry.Enabled }}
{{- if .ADL.Spec.Language.Go }}

# OpenTelemetry (spec.telemetry.enabled: true)
# A2A_TELEMETRY_ENABLE is the ADK master switch: it turns on instrumentation and
# the telemetry server. The A2A_OTEL_* variables are the standard OpenTelemetry
# SDK settings read through the ADK's A2A_-prefixed config, so each OTEL_* name is
# emitted with the A2A_ prefix; every one maps 1:1 to a spec.telemetry field. A
# signal set to "none" is disabled; drop an OTLP endpoint/protocol to fall back to
# the SDK default. Auth headers, credentials, and sampling stay runtime concerns.
# W3C trace-context + baggage propagation is automatic.
A2A_TELEMETRY_ENABLE=true
{{- range telemetryEnvVars .ADL }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- end }}
{{- if .ADL.Spec.Language.TypeScript }}

# OpenTelemetry (spec.telemetry.enabled: true)
# A2A_TELEMETRY_ENABLE is the master switch. Each A2A_OTEL_* below maps 1:1 to a
# spec.telemetry field; the generated index.ts mirrors them onto the standard
# OTEL_* names the OpenTelemetry Node SDK reads. Prometheus pull is not supported
# by the TS ADK yet - push to a collector via OTLP instead.
A2A_TELEMETRY_ENABLE=true
{{- range telemetryEnvVars .ADL }}
{{ .Key }}={{ .Value }}
{{- end }}
# OTLP headers and sampling stay runtime-only.
# Service name and version default to the agent card values.
# A2A_OTEL_SERVICE_NAME=
# A2A_OTEL_SERVICE_VERSION=
{{- end }}
{{- end }}
