# Gateway
ANTHROPIC_API_KEY=
CLOUDFLARE_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=
OLLAMA_CLOUD_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# A2A Agent Server / LLM client
A2A_DEBUG=false
{{- if .ADL.Spec.Agent }}
A2A_AGENT_CLIENT_PROVIDER={{ .ADL.Spec.Agent.Provider }}
A2A_AGENT_CLIENT_MODEL={{ .ADL.Spec.Agent.Model }}
A2A_AGENT_CLIENT_BASE_URL=http://gateway:8080/v1
{{- end }}

# CLI
{{- if .ADL.Spec.Agent }}
CLI_PROVIDER={{ .ADL.Spec.Agent.Provider }}
CLI_MODEL={{ .ADL.Spec.Agent.Model }}
{{- end }}
{{- if and .ADL.Spec.Language.Rust (has "redis" .ADL.Spec.Language.Rust.Features) }}

# Task queue (Redis)
A2A_QUEUE_PROVIDER=redis
A2A_QUEUE_URL=redis://localhost:6379
A2A_QUEUE_NAMESPACE=a2a
{{- end }}
{{- if and .ADL.Spec.Telemetry .ADL.Spec.Telemetry.Enabled }}
{{- if .ADL.Spec.Language.Go }}

# OpenTelemetry (spec.telemetry.enabled: true)
# The ADK turns on the telemetry/metrics server and instrumentation when
# A2A_TELEMETRY_ENABLE=true. Metrics are exposed for Prometheus scraping on
# A2A_TELEMETRY_METRICS_PORT (default 9090). W3C trace-context + baggage
# propagation is automatic - no code changes needed.
A2A_TELEMETRY_ENABLE=true
A2A_TELEMETRY_METRICS_PORT=9090
A2A_TELEMETRY_METRICS_HOST=
# OTLP trace export (disabled by default; point it at your collector to turn on).
A2A_TELEMETRY_TRACE_ENABLE=false
A2A_TELEMETRY_TRACE_ENDPOINT=http://localhost:4318
# A2A_TELEMETRY_TRACE_HEADERS=
# OTLP log export is reserved in the ADK and not yet wired - leave disabled.
# A2A_TELEMETRY_LOG_ENABLE=false
# A2A_TELEMETRY_LOG_ENDPOINT=http://localhost:4318
# A2A_TELEMETRY_LOG_HEADERS=
{{- end }}
{{- if .ADL.Spec.Language.TypeScript }}

# OpenTelemetry (spec.telemetry.enabled: true)
# The TypeScript ADK starts the OpenTelemetry Node SDK when TELEMETRY_ENABLE is
# truthy and pushes traces/metrics/logs over OTLP HTTP to the standard
# OTEL_EXPORTER_OTLP_* endpoint. Unlike the A2A_-prefixed ADK options above,
# these follow the OpenTelemetry-standard variable names.
TELEMETRY_ENABLE=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME and OTEL_SERVICE_VERSION default to the agent card values.
# OTEL_SERVICE_NAME=
# OTEL_SERVICE_VERSION=
{{- end }}
{{- end }}
