version: '3'

vars:
  APP_NAME: {{ .ADL.Metadata.Name }}
  VERSION: {{ .ADL.Metadata.Version }}

tasks:
  validate:
    desc: Validate ADL
    cmd: {{- if eq .Language "typescript" }} pnpm run validate
    {{- else }} adl validate agent.yaml
    {{- end }}

  generate:
    desc: Generate code from ADL
    cmd: {{- if eq .Language "typescript" }} pnpm run generate
    {{- else }} {{ .GenerateCommand }}
    {{- end }}

  build:
    desc: Build the application
    cmd: {{- if eq .Language "go" }} go build -o bin/{{`{{.APP_NAME}}`}} .
    {{- else if eq .Language "rust" }} cargo build --release
    {{- else if eq .Language "typescript" }} pnpm run build
    {{- end }}

  run:
    desc: Run the application in development mode
    cmd: {{- if eq .Language "go" }} go run . start
    {{- else if eq .Language "rust" }} cargo run -- start
    {{- else if eq .Language "typescript" }} pnpm run dev
    {{- end }}
    env:
      A2A_DEBUG: true
      A2A_SERVER_PORT: {{ .ADL.Spec.Server.Port | default 8080 }}

  test:
    desc: Run tests
    cmd: {{- if eq .Language "go" }} go test -v ./...
    {{- else if eq .Language "rust" }} cargo test
    {{- else if eq .Language "typescript" }} pnpm test
    {{- end }}

  test:cover:
    desc: Run tests with coverage
    cmd: {{- if eq .Language "go" }} go test -v -cover ./...
    {{- else if eq .Language "rust" }} cargo tarpaulin
    {{- else if eq .Language "typescript" }} pnpm run test:coverage
    {{- end }}

  fmt:
    desc: Format code
    cmd: {{- if eq .Language "go" }} go fmt ./...
    {{- else if eq .Language "rust" }} cargo fmt
    {{- else if eq .Language "typescript" }} pnpm run format
    {{- end }}

  lint:
    desc: Run linter
    cmd: {{- if eq .Language "go" }} golangci-lint run
    {{- else if eq .Language "rust" }} cargo clippy
    {{- else if eq .Language "typescript" }} pnpm run typecheck
    {{- end }}

  clean:
    desc: Clean build artifacts
    cmd: {{- if eq .Language "go" }} rm -rf bin/
    {{- else if eq .Language "rust" }} cargo clean
    {{- else if eq .Language "typescript" }} rm -rf dist/
    {{- end }}

  docker:build:
    desc: Build Docker image
    cmd: docker build -t {{`{{.APP_NAME}}`}}:{{`{{.VERSION}}`}} .

{{- if .ADL.Spec.Deployment }}
{{- if eq .ADL.Spec.Deployment.Type "kubernetes" }}

  deploy:
    desc: Deploy to Kubernetes
    cmd: kubectl apply -f k8s/
{{- else if eq .ADL.Spec.Deployment.Type "cloudrun" }}
{{- $cr := .ADL.Spec.Deployment.CloudRun }}
{{- $cpu := "1" }}
{{- $memory := "512Mi" }}
{{- $minInstances := 0 }}
{{- $maxInstances := 10 }}
{{- $concurrency := 1000 }}
{{- $timeout := 3600 }}
{{- $serviceAccount := printf "%s@${PROJECT_ID}.iam.gserviceaccount.com" .ADL.Metadata.Name }}
{{- $executionEnvironment := "gen2" }}
{{- $allowUnauthenticated := true }}
{{- $image := printf "gcr.io/${PROJECT_ID}/%s:%s" .ADL.Metadata.Name .ADL.Metadata.Version }}
{{- $useCloudBuild := false }}
{{- $extraEnv := "" }}
{{- if $cr }}
{{- if $cr.Resources }}
{{- $cpu = $cr.Resources.CPU | default $cpu }}
{{- $memory = $cr.Resources.Memory | default $memory }}
{{- end }}
{{- if $cr.Scaling }}
{{- $minInstances = $cr.Scaling.MinInstances | default $minInstances }}
{{- $maxInstances = $cr.Scaling.MaxInstances | default $maxInstances }}
{{- $concurrency = $cr.Scaling.Concurrency | default $concurrency }}
{{- end }}
{{- if $cr.Service }}
{{- $timeout = $cr.Service.Timeout | default $timeout }}
{{- $serviceAccount = $cr.Service.ServiceAccount | default $serviceAccount }}
{{- $executionEnvironment = $cr.Service.ExecutionEnvironment | default $executionEnvironment }}
{{- $allowUnauthenticated = $cr.Service.AllowUnauthenticated }}
{{- end }}
{{- if $cr.Image }}
{{- $image = printf "%s/%s:%s" ($cr.Image.Registry | default "gcr.io") ($cr.Image.Repository | default (printf "${PROJECT_ID}/%s" .ADL.Metadata.Name)) ($cr.Image.Tag | default .ADL.Metadata.Version) }}
{{- $useCloudBuild = $cr.Image.UseCloudBuild }}
{{- end }}
{{- range $key, $value := $cr.Environment }}
{{- $extraEnv = printf "%s,%s=%s" $extraEnv $key $value }}
{{- end }}
{{- end }}

  deploy:
    desc: Deploy to Google Cloud Run
{{- if not $useCloudBuild }}
    deps:
      - docker:build
{{- end }}
    env:
      SERVICE_NAME: "{{ .ADL.Metadata.Name }}"
      PORT: "{{ .ADL.Spec.Server.Port | default 8080 }}"
    cmds:
      - |
        if [ -z "$PROJECT_ID" ]; then
          echo "Error: PROJECT_ID environment variable is required"
          exit 1
        fi
        if [ -z "$REGION" ]; then
          echo "Error: REGION environment variable is required" 
          exit 1
        fi
{{- if $useCloudBuild }}
      - |
        echo "Building and pushing image using Cloud Build..."
        gcloud builds submit --tag {{ $image }}
{{- else }}
      - |
        echo "Pushing image to {{ $image }}"
        docker tag ${SERVICE_NAME}:{{ .ADL.Metadata.Version }} {{ $image }}
        docker push {{ $image }}
{{- end }}
      - |
        echo "Deploying to Cloud Run..."
        gcloud run deploy ${SERVICE_NAME} \
          --image {{ $image }} \
          --platform managed \
          --region ${REGION} \
          --port ${PORT} \
          {{ if $allowUnauthenticated }}--allow-unauthenticated{{ else }}--no-allow-unauthenticated{{ end }} \
          --set-env-vars "A2A_SERVER_PORT=${PORT},ENV=production{{ if .ADL.Spec.Server.Debug }},DEBUG=true{{ end }}{{ $extraEnv }}" \
          --cpu "{{ $cpu }}" \
          --memory "{{ $memory }}" \
          --min-instances {{ $minInstances }} \
          --max-instances {{ $maxInstances }} \
          --concurrency {{ $concurrency }} \
          --timeout {{ $timeout }} \
          --service-account "{{ $serviceAccount }}" \
          --execution-environment {{ $executionEnvironment }}
      - |
        echo "Deployment completed successfully!"
        echo "Service URL: $(gcloud run services describe ${SERVICE_NAME} --region=${REGION} --format='value(status.url)')"

  deploy:cloud-build:
    desc: Deploy to Google Cloud Run using Cloud Build
    env:
      SERVICE_NAME: "{{ .ADL.Metadata.Name }}"
      PORT: "{{ .ADL.Spec.Server.Port | default 8080 }}"
    cmds:
      - |
        if [ -z "$PROJECT_ID" ]; then
          echo "Error: PROJECT_ID environment variable is required"
          exit 1
        fi
        if [ -z "$REGION" ]; then
          echo "Error: REGION environment variable is required"
          exit 1
        fi
      - |
        echo "Building and pushing image using Cloud Build..."
        gcloud builds submit --tag {{ $image }}
      - |
        echo "Deploying to Cloud Run..."
        gcloud run deploy ${SERVICE_NAME} \
          --image {{ $image }} \
          --platform managed \
          --region ${REGION} \
          --port ${PORT} \
          {{ if $allowUnauthenticated }}--allow-unauthenticated{{ else }}--no-allow-unauthenticated{{ end }} \
          --set-env-vars "A2A_SERVER_PORT=${PORT},ENV=production{{ if .ADL.Spec.Server.Debug }},DEBUG=true{{ end }}{{ $extraEnv }}" \
          --cpu "{{ $cpu }}" \
          --memory "{{ $memory }}" \
          --min-instances {{ $minInstances }} \
          --max-instances {{ $maxInstances }} \
          --concurrency {{ $concurrency }} \
          --timeout {{ $timeout }} \
          --service-account "{{ $serviceAccount }}" \
          --execution-environment {{ $executionEnvironment }}
      - |
        echo "Deployment completed successfully!"
        echo "Service URL: $(gcloud run services describe ${SERVICE_NAME} --region=${REGION} --format='value(status.url)')"
{{- else if eq .ADL.Spec.Deployment.Type "vercel" }}

  deploy:
    desc: Deploy to Vercel
    env:
      VERCEL_PROJECT: "{{ if .ADL.Spec.Deployment.Vercel }}{{ .ADL.Spec.Deployment.Vercel.Project }}{{ end }}"
      VERCEL_ORG: "{{ if .ADL.Spec.Deployment.Vercel }}{{ .ADL.Spec.Deployment.Vercel.Team }}{{ end }}"
    cmds:
      - |
        if ! command -v vercel >/dev/null 2>&1; then
          echo "Error: the vercel CLI is required. Install it with: npm i -g vercel"
          exit 1
        fi
      - |
        echo "Linking Vercel project ${VERCEL_PROJECT} (team ${VERCEL_ORG})..."
        vercel link --yes --project "${VERCEL_PROJECT}"{{ if and .ADL.Spec.Deployment.Vercel .ADL.Spec.Deployment.Vercel.Team }} --scope "${VERCEL_ORG}"{{ end }}
      - |
        echo "Pulling Vercel project settings..."
        vercel pull --yes{{ if and .ADL.Spec.Deployment.Vercel .ADL.Spec.Deployment.Vercel.Team }} --scope "${VERCEL_ORG}"{{ end }}
      - |
        echo "Deploying to Vercel..."
        vercel deploy --prod{{ if and .ADL.Spec.Deployment.Vercel .ADL.Spec.Deployment.Vercel.Team }} --scope "${VERCEL_ORG}"{{ end }}
{{- end }}
{{- end }}
