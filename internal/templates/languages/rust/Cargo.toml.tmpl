[package]
name = "{{ .ADL.Spec.Language.Rust.PackageName }}"
version = "{{ .ADL.Metadata.Version }}"
edition = "{{ .ADL.Spec.Language.Rust.Edition }}"
rust-version = "{{ .ADL.Spec.Language.Rust.Version }}"
description = "{{ .ADL.Metadata.Description }}"
license = "Apache-2.0"

[dependencies]
{{- if .ADL.Spec.Language.Rust.Features }}
inference-gateway-adk = { version = "{{ pin "cargo" "inference-gateway-adk" }}", features = [{{- range $i, $f := .ADL.Spec.Language.Rust.Features }}{{ if $i }}, {{ end }}{{ $f | quote }}{{- end }}] }
{{- else }}
inference-gateway-adk = "{{ pin "cargo" "inference-gateway-adk" }}"
{{- end }}
inference-gateway-sdk = "{{ pin "cargo" "inference-gateway-sdk" }}"
tokio = { version = "{{ pin "cargo" "tokio" }}", features = ["full", "signal"] }
tracing = "{{ pin "cargo" "tracing" }}"
tracing-subscriber = { version = "{{ pin "cargo" "tracing-subscriber" }}", features = ["env-filter"] }
clap = { version = "{{ pin "cargo" "clap" }}", features = ["derive"] }
serde = { version = "{{ pin "cargo" "serde" }}", features = ["derive"] }
serde_json = "{{ pin "cargo" "serde_json" }}"
serde_yaml = "{{ pin "cargo" "serde_yaml" }}"
anyhow = "{{ pin "cargo" "anyhow" }}"
async-trait = "{{ pin "cargo" "async-trait" }}"
uuid = { version = "{{ pin "cargo" "uuid" }}", features = ["v4", "serde"] }
chrono = { version = "{{ pin "cargo" "chrono" }}", features = ["serde"] }
dotenvy = "{{ pin "cargo" "dotenvy" }}"
envy = "{{ pin "cargo" "envy" }}"
{{- $hasFetch := false }}
{{- $hasBuiltin := false }}
{{- range .ADL.Spec.Tools }}
{{- if eq .ID "fetch" }}
{{- $hasFetch = true }}
{{- end }}
{{- if isBuiltinToolID .ID }}
{{- $hasBuiltin = true }}
{{- end }}
{{- end }}
{{- if $hasFetch }}
reqwest = { version = "{{ pin "cargo" "reqwest" }}", default-features = false, features = ["rustls-tls", "json"] }
{{- end }}
{{- range .Vendor.CargoDeps }}
{{ .Name }} = "{{ .Version }}"
{{- end }}
{{- range .Vendor.CargoIndirect }}
{{ .Name }} = "{{ .Version }}" # indirect: transitive version pin, not imported directly
{{- end }}
{{- if or $hasBuiltin .Vendor.CargoDevDeps }}

[dev-dependencies]
{{- if $hasBuiltin }}
tempfile = "{{ pin "cargo-dev" "tempfile" }}"
{{- end }}
{{- range .Vendor.CargoDevDeps }}
{{ .Name }} = "{{ .Version }}"
{{- end }}
{{- end }}

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
