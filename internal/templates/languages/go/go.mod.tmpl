module {{ .ADL.Spec.Language.Go.Module }}

go {{ .ADL.Spec.Language.Go.Version }}

require (
{{- range .Vendor.GoBuiltinEntries }}
	{{ .Name }} {{ .Version }}
{{- end }}
{{- if and .ADL.Spec.Telemetry .ADL.Spec.Telemetry.Enabled }}
	go.opentelemetry.io/otel v1.45.0
	go.opentelemetry.io/otel/trace v1.46.0
{{- end }}
{{- range .Vendor.GoRequires }}
	{{ .Name }} {{ .Version }}
{{- end }}
{{- range .Vendor.GoTools }}
	{{ .Name }} {{ .Version }} // indirect
{{- end }}
)
{{ if .Vendor.GoTools }}
tool (
{{- range .Vendor.GoTools }}
	{{ .Name }}
{{- end }}
)
{{- end }}
