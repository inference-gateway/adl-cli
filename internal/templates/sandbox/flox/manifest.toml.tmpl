schema-version = "{{ pin "tool" "flox-schema" }}"

[install]
{{- if ne .Language "typescript" }}
{{- if and .Metadata.CLIVersion (ne .Metadata.CLIVersion "dev") }}
adl.flake = "github:inference-gateway/adl-cli/v{{ .Metadata.CLIVersion }}"
{{- else }}
adl.flake = "github:inference-gateway/adl-cli"
{{- end }}
{{- end }}
{{- if eq .Language "go" }}
go.pkg-path = "go"
go.version = "{{ .ADL.Spec.Language.Go.Version }}"

golangci-lint.pkg-path = "golangci-lint"
golangci-lint.version = "^{{ pin "tool" "golangci-lint" }}"
golangci-lint.pkg-group = "common"

{{- else if eq .Language "rust" }}
cargo.pkg-path = "cargo"
cargo.version = "^{{ pin "tool" "rust" }}"
cargo.pkg-group = "rust-toolchain"

rustc.pkg-path = "rustc"
rustc.version = "^{{ pin "tool" "rust" }}"
rustc.pkg-group = "rust-toolchain"

clippy.pkg-path = "clippy"
clippy.version = "^{{ pin "tool" "rust" }}"
clippy.pkg-group = "rust-toolchain"

rustfmt.pkg-path = "rustfmt"
rustfmt.version = "^{{ pin "tool" "rust" }}"
rustfmt.pkg-group = "rust-toolchain"

rust-analyzer.pkg-path = "rust-analyzer"
rust-analyzer.version = "{{ pin "tool" "rust-analyzer" }}"
rust-analyzer.pkg-group = "rust-analyzer"
{{- else if eq .Language "typescript" }}
nodejs_24.pkg-path = "nodejs_24"
nodejs_24.version = "^{{ pin "tool" "nodejs" }}"

pnpm.pkg-path = "pnpm"
pnpm.version = "^{{ pin "tool" "pnpm" }}"
{{- end }}

go-task.pkg-path = "go-task"
go-task.version = "^{{ pin "tool" "go-task" }}"
go-task.pkg-group = "common"

git.pkg-path = "git"
git.version = "^{{ pin "tool" "git" }}"
git.pkg-group = "common"

docker.pkg-path = "docker"
docker.version = "^{{ pin "tool" "docker" }}"
docker.pkg-group = "common"
{{- if .AIToggles.ClaudeCode }}

claude-code.pkg-path = "claude-code"
claude-code.version = "^{{ pin "tool" "claude-code" }}"
claude-code.pkg-group = "common"
{{- end }}
{{- if .AIToggles.Infer }}

infer.flake = "github:inference-gateway/cli/v{{ pin "tool" "infer" }}"
{{- end }}
{{- if .SandboxDeps.HasDeps }}

# Extra packages declared in spec.development.deps. Each entry is rendered
# as a Flox install line resolved against Nixpkgs. The package name from
# the ADL ('<package>@<version>') becomes the Nixpkgs attribute path; if a
# package is exposed under a different attribute path in Nixpkgs you may
# need to add it under .adl-ignore and hand-author the override.
{{- range .SandboxDeps.Deps }}
{{ .Name }}.pkg-path = "{{ .Name }}"
{{ .Name }}.version = "{{ .Version }}"
{{- end }}
{{- end }}

[hook]
on-activate = '''
  echo "🌟 Welcome to {{ .ADL.Metadata.Name }} development environment!"
  {{- if eq .Language "go" }}
  echo "Go version: $(go version)"
  {{- else if eq .Language "rust" }}
  echo "Rust version: $(rustc --version)"
  {{- else if eq .Language "typescript" }}
  echo "Node version: $(node --version)"
  {{- end }}
'''
